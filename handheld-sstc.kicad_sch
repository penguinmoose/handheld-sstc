	(text "R13 pulls up gate driver\ninput above threshold\nto kick-start oscillation."
		(exclude_from_sim no)
		(at 127.762 91.694 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "7a36c510-fb9d-4731-a112-69da6cdc24c0")
	)
	(text "C5 and C6 must be physically close to gate driver IC.\nSpecifically, C6 should be as close as possible to gate driver IC"
		(exclude_from_sim no)
		(at 85.598 108.712 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
		)
		(uuid "91b57c74-d5b5-4607-b2d8-5ae91367e56c")
	)
	(text "IMPORTANT! Disconnect bottom of secondary if using current transformer (CT) feedback!\nOnly use current transformer or direct secondary connection, not both!"
		(exclude_from_sim no)
		(at 155.956 140.208 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "cf9dc0ca-00ea-4d3b-8839-1f4d35c3476e")
	)
	(text "Note: Disconnect JP1 to use ext. 15V in\nConnect JP1 for normal operation or to use ext. 15V out\nIf VCC<18V, also disconnect JP2"
