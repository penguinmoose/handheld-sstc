		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.1875)
			)
			(justify mirror)
		)
	)
	(gr_text "It uses direct secondary feedback,\nwhich gets clamped by D1,D2\nand then fed to gate driver (U1).\nThe gate driver drives up to 3\nparrelled   MOSFETs, switching the\nprimary coil. Has protection diodes\n(reverse protection,\nTVS, etc) for FETs,\nas well as other protections.\nUses 555 interrupter, VR1/VR2 to\nadjust, SW1 to switch CW / Interrupted"
		(at 194 120 0)
		(layer "B.SilkS")
		(uuid "29351dc5-7322-40ff-87bb-62df6d349bb0")
		(effects
			(font
				(size 1 1)
				(thickness 0.2)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "J3"
		(at 200.8 128.6 -90)
		(layer "B.SilkS")
		(uuid "4dcc7914-ffd9-4ba3-8153-3cc104304b51")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify mirror)
		)
	)
	(gr_text "Pri-"
		(at 225.75 123 90)
		(layer "B.SilkS")
		(uuid "4e362773-1172-40ee-b772-84932edba12d")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.1875)
			)
			(justify mirror)
		)
	)
	(gr_text "Start with only the middle FET (Q2), add if needed.\nIf using lower performance FETs (i.e. IRF640N), can use 3"
		(at 222.25 80.25 0)
		(layer "B.SilkS")
