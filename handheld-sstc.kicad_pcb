		(effects
			(font
				(size 1 1)
				(thickness 0.125)
			)
			(justify mirror)
		)
	)
	(gr_text "Hello! This is my handheld SSTC, in a\nlarge {dblquote}magic wand{dblquote} form factor.\nIt was based on Hyperspace Pirate's\n{dblquote}Tabletop Tesla Coil{dblquote},\nbut I made heavy modifications and\nchanges, for example using gate\ndriver, improving interrupter, better\nMOSFET protections and efficency, etc."
		(at 205.5 95 0)
		(layer "B.SilkS")
		(uuid "a69f713e-3eb3-417a-9eeb-2deeb5b309b7")
		(effects
			(font
				(size 1 1)
				(thickness 0.2)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
